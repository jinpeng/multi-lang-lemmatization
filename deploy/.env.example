# Copy to .env in THIS directory (deploy/) and fill in the values.
#
#   cp .env.example .env
#
# Compose reads .env from the directory containing docker-compose.yml, not from
# your current directory. A .env at the repo root is silently ignored.
#
# .env is git-ignored. Never commit real values.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Encrypts every stored API secret (AES-256-GCM). 32 random bytes, hex.
#   python3 -c 'import secrets; print(secrets.token_hex(32))'
#
# LOSE THIS AND EVERY API KEY IS DEAD: the encrypted secrets in the database
# become unrecoverable by design. Back it up somewhere other than this host.
LEMMA_MASTER_KEY=

# Shared secret between the console and the API. Any long random string.
#   python3 -c 'import secrets; print("svc-" + secrets.token_hex(16))'
LEMMA_SERVICE_TOKEN=

# Argon2id hash of the console admin passphrase.
#
# DO NOT paste the raw hash. Compose interpolates '$', and a hash looks like
#   $argon2id$v=19$m=65536,t=3,p=4$salt$hash
# which would silently arrive as "=19=65536,t=3,p=4" and make every login fail
# with "wrong passphrase" -- reading like a credentials bug, not a config one.
#
# Generate the escaped line directly (note the doubled $$):
#   python -m api.cli env-line 'your passphrase' >> .env
#
# then delete this comment block. The API refuses to start if the value is
# present but does not begin with $argon2id.
#
# Leave empty for an API-only deployment with no console.
LEMMA_ADMIN_PASSPHRASE_HASH=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Credential the Playground uses server-side so the browser never holds a key.
# Format: <key_id>.<secret>, both halves required.
#
# Create it after the stack is up:
#   docker compose exec api python -m api.cli create-key --name console-demo --allow-hmac
# then restart the console:  docker compose up -d console
#
# Empty = the Playground renders but every request returns NO_DEMO_KEY.
LEMMA_DEMO_KEY=

# Public base URL shown in the "Equivalent request" curl snippet.
# Cosmetic only; it is never called. Set it to wherever your API is reachable
# from outside, e.g. https://lemma.example.com
LEMMA_PUBLIC_API_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Set inside the image, listed here for reference. Do not set in .env.
# ---------------------------------------------------------------------------
#
# LEMMA_AUTH_ENABLED=1     forced on by deploy/api.Dockerfile
# LEMMA_REQUIRE_AUTH=1     makes create_app() refuse to boot if auth is off
# LEMMA_DB_PATH            /data/lemming.db, matching the volume mount
# LEMMA_WORKERS=2          uvicorn workers; each loads all 7 backends (~450-570MB)
